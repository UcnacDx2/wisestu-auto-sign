# 用户配置
user:
  username: ""          # 用户名
  password: ""          # 密码
  
# 位置信息（签到时原样上报，需按实际地点填写）
location:
  longitude: 0.000000   # 经度，必须填写
  latitude: 0.000000    # 纬度，必须填写
  address: "XX省XX市XX区XX路X号XX楼" # 完整地址
  province: "XX省"
  city: "XX市"
  district: "XX区"
  street: "XX路"
  street_number: "X号"

# LLM API 配置
llm:
  api_key: "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"           # API Key
  endpoint: "https://xx.com/v1/chat/completions"
  model: "gpt-4.1-mini"
  
# 签到配置
signin:
  base_url: "https://example.com"  # 签到平台基址，按实际填写
  retry_times: 3        # 重试次数
  retry_interval: "5s"  # 重试间隔
  
# 调度配置
scheduler:
  enabled: true
  cron: "0 8,14,18 * * 1"  # 每周一的 8点、14点、18点
  timezone: "Asia/Shanghai"
  
# 日志配置
logging:
  level: "info"
  file: "logs/signin.log"
  max_size: 100         # MB
  max_backups: 5
  max_age: 30           # 天
  debug: false          # 是否启用 HTTP 调试日志